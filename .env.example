# tfh-local environment. Copy to .env (`cp .env.example .env`) and fill in locally.
# NAMES ONLY in this file. Never commit values. Empty = compose default (ports, local DB names) or "disabled".
# Credentials come from the team's dev/stage set (tf-api's local .env / Slack). Never prod values, never committed.
# SAFETY: scripts/preflight.sh refuses to start if Sticky/TF hosts are not on safety/nonprod-hosts.txt,
# match safety/prod-denylist.txt (except exact entries in safety/reviewed-exceptions.txt), or if any Syteline/Infor, tfhcore or Avalara variable is set.

# ---- External integrations mode ----
# Standard setup: EXTERNALS=real (approved by Michael 2026-11-20): the Sticky and TF Composition API dev endpoints
#   that develop/stage use, TEST ORDERS ONLY. Set it in your .env; it stays empty here so `make test` stays offline.
# Empty = offline (safe fallback without credentials). offline: Sticky/TF are unreachable, STICKY_* and TF_COMPOSITION_*
#   must be empty (or a *.invalid placeholder). Checkout / order create / cancel / order-sync fail locally.
# real: also needs STICKY_USERNAME/PASSWORD, STICKY_APP_KEY and TF_COMPOSITION_API_TOKEN. See docs/safety.md.
EXTERNALS=

# ---- Local identity of this stack (must not be production) ----
APP_ENV=
COMPOSE_PROJECT_NAME=

# ---- Host ports (non-default to avoid clashing with dev servers) ----
POSTGRES_HOST_PORT=
REDIS_HOST_PORT=
TF_API_HOST_PORT=
MAILPIT_UI_HOST_PORT=
MAILPIT_SMTP_HOST_PORT=
MINIO_API_HOST_PORT=
MINIO_CONSOLE_HOST_PORT=
KLAVIYO_RECORDER_HOST_PORT=
MEMBERPORTAL_HOST_PORT=
ADMIN_PANEL_HOST_PORT=
FUNNELS_HOST_PORT=
APIGATEWAY_HOST_PORT=
VECTOR_SEARCH_HOST_PORT=

# ---- Local Postgres (container only; DB host is always the local container) ----
# REQUIRED credentials (docker-compose.yml has NO defaults; `make bootstrap` generates any that are empty):
#   POSTGRES_USER POSTGRES_PASSWORD APP_DB_USER APP_DB_PASS MINIO_ROOT_USER MINIO_ROOT_PASSWORD
#   GATEWAY_DB_USER GATEWAY_DB_PASSWORD KRATOS_SECRETS_COOKIE KRATOS_SECRETS_CIPHER
POSTGRES_USER=
POSTGRES_PASSWORD=
APP_DB_USER=
APP_DB_PASS=
APP_DB_NAME=
DB_HOST=

# ---- Sticky.io: the shared instance (develop/stage/prod use it), TEST ORDERS ONLY (EXTERNALS=real only; EMPTY when offline) ----
# Hosts: STICKY_DOMAIN=limelightcrm.com  STICKY_API_EXT=/api/v1/  STICKY_API_EXT_2=/api/v2/
# STICKY_APP_KEY must be one DNS label; credentials from the team's dev/stage set.
STICKY_DOMAIN=
STICKY_API_EXT=
STICKY_API_EXT_2=
STICKY_APP_KEY=
STICKY_USERNAME=
STICKY_PASSWORD=
STICKY_WEBHOOK_USERNAME=
STICKY_WEBHOOK_PASSWORD=

# ---- TF Composition API: DEV system (what develop/stage use), TEST ORDERS ONLY (EXTERNALS=real only; EMPTY when offline) ----
# Host: TF_COMPOSITION_API_BASE_URL=https://api.dev.trulyfree.com  (the prod TF API host stays denied)
# TF_SELLING_PLAN_ID = the stage plan id from the team's dev/stage set.
TF_COMPOSITION_API_BASE_URL=
TF_COMPOSITION_API_TOKEN=
TF_SELLING_PLAN_ID=

# ---- S3 -> local MinIO (same bucket NAMES as the non-prod config) ----
# REQUIRED (generated by make bootstrap)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
AWS_REGION=
AWS_BUCKET=
AWS_CDN_DOMAIN=
AWS_IMAGE_PATH=
AWS_PRESIGNED_URL_EXPIRY_MINUTES=
CATALOG_S3_BUCKET=
CATALOG_S3_KEY=
SEARCH_MODEL_S3_BUCKET=
SEARCH_MODEL_S3_KEY=
SEARCH_MODEL_S3_TMP_KEY=
SITEMAP_S3_BUCKET=
SITEMAP_S3_KEY=
YOTPO_S3_BUCKET=
YOTPO_S3_KEY=

# ---- Klaviyo -> local recorder (no real Klaviyo). Keys may stay empty. ----
KLAVIYO_PUBLIC_KEY=
KLAVIYO_PRIVATE_KEY=
KLAVIYO_LIST_ID=
KLAVIYO_LIST_ID_2=
KLAVIYO_LIST_ID_3=
KLAVIYO_LIST_ID_4=

# ---- Builder.io (read-only public content) ----
BUILDER_API_KEY=
BUILDER_API_URL=
# Builder.io PUBLIC keys for memberportal / funnels (read-only content API via proxy/readonly-allowlist.txt).
# Empty = Builder pages 404 locally. Copy from memberportal/.env.develop and nextjs-aff-landing-pages/.env.
LOCAL_BUILDER_PUBLIC_KEY_PORTAL=
LOCAL_BUILDER_PUBLIC_KEY_FUNNEL=

# ---- Auth gateway (tf-apigateway + Kratos + Keto) - REQUIRED; make bootstrap generates local random values ----
GATEWAY_DB_USER=
GATEWAY_DB_PASSWORD=
GATEWAY_DB_NAME=
KRATOS_SECRETS_COOKIE=
# exactly 32 characters
KRATOS_SECRETS_CIPHER=
KRATOS_PUBLIC_HOST_PORT=
KRATOS_ADMIN_HOST_PORT=

# ---- Local auth users (seed/auth-users.sh; make bootstrap generates). Customer: local-only email (*@tfh-local.test).
# Admin: exactly local-admin@trulyfreehome.com (local Kratos identity, not a mailbox; any other company address is refused) ----
TEST_CUSTOMER_PORTAL_EMAIL=
TEST_CUSTOMER_PORTAL_PASSWORD=
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=

# ---- tf-api HTTP Basic auth (BASIC_AUTH_ENABLED=true locally; make bootstrap generates; local-only values) ----
# Passed to tf-api and to memberportal / admin panel / funnels as BASIC_AUTH_USERNAME/PASSWORD (server env only),
# and to tfh-automation's local env by `make verify`. Never copy a real environment's values here.
TF_API_BASIC_AUTH_USERNAME=
TF_API_BASIC_AUTH_PASSWORD=

# ---- tfh-automation (suite on the host) ----
TFH_AUTOMATION_TARGET_ENV=
# Order tests with EXTERNALS=real (make verify exports them to the suite). First/last name MUST be test / test
# (the suite refuses anything else); use the local portal test customer's *.test email, a fictional address/phone,
# and the Sticky / TF TEST cards from the team's test-card set (never a real card). The order specs require both sets.
TEST_CUSTOMER_FIRST_NAME=
TEST_CUSTOMER_LAST_NAME=
TEST_CUSTOMER_EMAIL=
TEST_CUSTOMER_PHONE=
TEST_CUSTOMER_STREET=
TEST_CUSTOMER_CITY=
TEST_CUSTOMER_STATE=
TEST_CUSTOMER_ZIP=
TEST_CUSTOMER_COUNTRY=
TFH_STICKY_CARD_NUMBER=
TFH_STICKY_CARD_EXP=
TFH_STICKY_CARD_CVV=
TFH_STICKY_CARD_NAME=
TF_SPREEDLY_CARD_NUMBER=
TF_SPREEDLY_CARD_EXP=
TF_SPREEDLY_CARD_CVV=
TF_SPREEDLY_CARD_NAME=

# ---- Bootstrap ----
LOCAL_SRC=

# ---- MUST STAY EMPTY / ABSENT (preflight refuses if set) ----
# SYTE_LINE_API, SYTE_LINE_API_KEY, any SYTELINE_* / INFOR_*   (never configured; never written)
# TFH_CORE_API_DOMAIN, TFHCORE_MYSQL_*                          (tfhcore is OUT)
# AVALARA_*                                                     (Avalara is OUT)
# SENTRY_DSN, CLOUDWATCH_*, FACEBOOK_*, CUSTOMERLABS_WEBHOOK_URL (disabled locally)
